#!/usr/bin/env bash
# Packages a release build for download: a .dmg holding notsuperhuman.app on
# macOS, a tarball on Linux, a zip on Windows.
#
# Usage: scripts/package TARGET
#   TARGET  the Rust target triple built with `cargo build --release --target`
# Writes dist/notsuperhuman-<platform>.<dmg|tar.gz|zip>.
set -euo pipefail

target=$1
version=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n 1)
bin=target/$target/release

case "$target" in
    aarch64-apple-darwin) platform=macos-arm64 ;;
    x86_64-apple-darwin) platform=macos-x86_64 ;;
    x86_64-unknown-linux-gnu) platform=linux-x86_64 ;;
    x86_64-pc-windows-msvc) platform=windows-x86_64 ;;
    *)
        echo "scripts/package: unsupported target $target" >&2
        exit 1
        ;;
esac

name=notsuperhuman-$platform
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
mkdir -p dist
dist=$(cd dist && pwd)

package_macos() {
    local app=$stage/dmg/notsuperhuman.app
    mkdir -p "$app/Contents/MacOS"
    cp "$bin/notsuperhuman" "$app/Contents/MacOS/notsuperhuman"
    strip -x "$app/Contents/MacOS/notsuperhuman"

    cat >"$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>notsuperhuman</string>
    <key>CFBundleExecutable</key>
    <string>notsuperhuman</string>
    <key>CFBundleIdentifier</key>
    <string>dev.nothq.notsuperhuman</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>notsuperhuman</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$version</string>
    <key>CFBundleVersion</key>
    <string>$version</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>LSMinimumSystemVersion</key>
    <string>${MACOSX_DEPLOYMENT_TARGET:-11.0}</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
</dict>
</plist>
PLIST

    # With MACOS_SIGNING_IDENTITY (a Developer ID Application identity in the
    # keychain) the app is signed for distribution with the hardened runtime.
    # Without it, an ad-hoc signature: Apple Silicon refuses unsigned code.
    local identity=${MACOS_SIGNING_IDENTITY:--}
    local sign_flags=(--force --sign "$identity")
    if [ "$identity" != - ]; then
        sign_flags+=(--options runtime --timestamp)
    fi
    codesign "${sign_flags[@]}" "$app"
    codesign --verify --strict --verbose=2 "$app"

    ln -s /Applications "$stage/dmg/Applications"
    hdiutil create -volname notsuperhuman -srcfolder "$stage/dmg" -ov -format UDZO "$dist/$name.dmg"

    if [ "$identity" != - ]; then
        codesign --force --timestamp --sign "$identity" "$dist/$name.dmg"
    fi
    # Notarize with an App Store Connect API key, then staple the ticket so the
    # app opens without a Gatekeeper warning, even offline.
    if [ "$identity" != - ] && [ -n "${APPLE_API_KEY_PATH:-}" ]; then
        xcrun notarytool submit "$dist/$name.dmg" --wait \
            --key "$APPLE_API_KEY_PATH" --key-id "$APPLE_API_KEY_ID" --issuer "$APPLE_API_ISSUER_ID"
        xcrun stapler staple "$dist/$name.dmg"
        spctl --assess --type open --context context:primary-signature --verbose=2 "$dist/$name.dmg"
    fi
}

package_linux() {
    local dir=$stage/$name
    mkdir -p "$dir"
    cp "$bin/notsuperhuman" "$dir/notsuperhuman"
    strip "$dir/notsuperhuman"
    cp LICENSE "$dir/"
    tar -czf "$dist/$name.tar.gz" -C "$stage" "$name"
}

package_windows() {
    local dir=$stage/$name
    mkdir -p "$dir"
    cp "$bin/notsuperhuman.exe" "$dir/"
    cp LICENSE "$dir/LICENSE.txt"
    (cd "$stage" && 7z a -tzip -mx=9 "$dist/$name.zip" "$name" >/dev/null)
}

case "$platform" in
    macos-*) package_macos ;;
    linux-*) package_linux ;;
    windows-*) package_windows ;;
esac

ls -l "$dist"
